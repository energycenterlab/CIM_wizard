@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix time: <http://www.w3.org/2006/time#> .

<http://www.w3.org/2006/time#> a owl:Ontology .

time:TemporalEntity  a owl:Class .
time:Instant         a owl:Class ; rdfs:subClassOf time:TemporalEntity .
time:Interval        a owl:Class ; rdfs:subClassOf time:TemporalEntity .

time:hasBeginning    a owl:ObjectProperty ;
    rdfs:range time:Instant .

time:hasEnd          a owl:ObjectProperty ;
    rdfs:range time:Instant .

time:inXSDDateTimeStamp a owl:DatatypeProperty ;
    rdfs:domain time:Instant ;
    rdfs:range  xsd:dateTimeStamp .
