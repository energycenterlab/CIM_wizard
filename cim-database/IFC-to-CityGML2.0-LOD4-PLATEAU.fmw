# -------------------------------------------------------------------------
INCLUDE [    if { "Z" == "X" } {       puts "MACRO XORIG_REAL 0";       puts "MACRO YORIG_REAL 0";       puts "MACRO ZORIG_REAL 0";       puts "MACRO XDIR_REAL 1";       puts "MACRO YDIR_REAL 0";       puts "MACRO ZDIR_REAL 0";    } elseif { "Z" == "Y" } {       puts "MACRO XORIG_REAL 0";       puts "MACRO YORIG_REAL 0";       puts "MACRO ZORIG_REAL 0";       puts "MACRO XDIR_REAL 0";       puts "MACRO YDIR_REAL 1";       puts "MACRO ZDIR_REAL 0";    } elseif { "Z" == "Z" } {       puts "MACRO XORIG_REAL 0";       puts "MACRO YORIG_REAL 0";       puts "MACRO ZORIG_REAL 0";       puts "MACRO XDIR_REAL 0";       puts "MACRO YDIR_REAL 0";       puts "MACRO ZDIR_REAL 1";    } else {    } ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_3DRotator }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT { FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_3DRotator_ROTATED"         @Affine("@EvaluateExpression(FDIV,FLOAT,<at>radToDeg<openparen><at>atan2<openparen><at>Value<openparen>__MapConversion.XAxisAbscissa<closeparen><comma><at>Value<openparen>__MapConversion.XAxisOrdinate<closeparen><closeparen><closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_3DRotator)","$(XORIG_REAL)","$(YORIG_REAL)","$(ZORIG_REAL)","$(XDIR_REAL)","$(YDIR_REAL)","$(ZDIR_REAL)",ROTATE)          }
