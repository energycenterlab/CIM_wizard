# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO GeometryReplacer_2_SetTempAttr
MACRO GeometryReplacer_2_Function
MACRO GeometryReplacer_2_RemoveTempAttr
MACRO GeometryReplacer_2_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>__geometry<closeparen>,GeometryReplacer_2)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO GeometryReplacer_2_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO GeometryReplacer_2_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO GeometryReplacer_2_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{fmebinary} == {fmebinary} } {               puts "MACRO GeometryReplacer_2_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmehex} } {               puts "MACRO GeometryReplacer_2_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmexml} } {               puts "MACRO GeometryReplacer_2_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmexmlencoded} } {               puts "MACRO GeometryReplacer_2_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{fmebinary} == {polyline} } {               puts "MACRO GeometryReplacer_2_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {wkt} } {               puts "MACRO GeometryReplacer_2_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {wkb} ||                      {fmebinary} == {wkbhex} } {               puts "MACRO GeometryReplacer_2_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GEOJSON} ||                     {fmebinary} == {ESRIJSON} } {               puts "MACRO GeometryReplacer_2_Function @JSONGeometry(FROM_ATTRIBUTE,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GEORSS} } {               puts "MACRO GeometryReplacer_2_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {KML} } {               puts "MACRO GeometryReplacer_2_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GML} } {               puts "MACRO GeometryReplacer_2_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {geohash} } {               puts "MACRO GeometryReplacer_2_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {ogeosms} ||                     {fmebinary} == {geosms}  ||                     {fmebinary} == {geo} } {               puts "MACRO GeometryReplacer_2_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {mgrs}} {               puts "MACRO GeometryReplacer_2_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>__geometry<closeparen>,GeometryReplacer_2)\")"           } elseif {{fmebinary} == {mssql} } {               puts "MACRO GeometryReplacer_2_Function @SerializeGeometry(from_attribute,fmebinary,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {iso6709} } {               puts "MACRO GeometryReplacer_2_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {qlikmaps} } {               puts "MACRO GeometryReplacer_2_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { GeometryReplacer_2_Rejector }    COMMAND_PARM_EVALUATION SINGLE_PASS    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    INPUT  FEATURE_TYPE NeighborFinder_UNMATCHED_CANDIDATE    $(GeometryReplacer_2_SetTempAttr)    FUNCTION_DEFINITION { $(GeometryReplacer_2_Function) }    OUTPUT { COMPLETE FEATURE_TYPE GeometryReplacer_2_OUTPUT        $(GeometryReplacer_2_RemoveTempAttr) $(GeometryReplacer_2_RemoveSourceAttr) }    OUTPUT { REJECTED FEATURE_TYPE GeometryReplacer_2_<REJECTED>        $(GeometryReplacer_2_RemoveTempAttr) }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
