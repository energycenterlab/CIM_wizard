MACRO 0b69ecf0_3923_473b_bc8d_b19b4a2d5db7FORMAT_MODE ${<transform>={"error":"$(XMLDeepCleaner_WORKSPACE_NAME)_XMLFormatter - 'Formatting Type:' must be given a value.","mapping":{"input":"__LOOKUP_INPUT","map":[{"from":"Linearize XML","to":"LINEARIZE"},{"from":"None","to":"NONE"},{"from":"Pretty-Print XML","to":"PRETTY_PRINT"}]},"required":"__LOOKUP_INPUT"}=}
