FACTORY_DEF {__DISABLED__} ExecuteFunctionFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_ToPoint }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_3DRotator_ROTATED"  @ConvertToPoint(CENTER_OF_GRAVITY, __CPx__, __CPy__, __CPz__)    FUNCTION_DEFINITION { @Scale(REJECTABLE,ALLOW_NULLS,"@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>__MapConversion.Scale<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler)","@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>__MapConversion.Scale<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler)","@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>__MapConversion.Scale<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler)",@Value(__CPx__),@Value(__CPy__),@Value(__CPz__),RASTER_EXTENTS) }    OUTPUT { COMPLETE FEATURE_TYPE $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_Scaled @RemoveAttributes(__CPx__,__CPy__,__CPz__) }    OUTPUT { REJECTED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_<REJECTED>"        @RemoveAttributes(__CPx__,__CPy__,__CPz__) }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_Scale }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_3DRotator_ROTATED"    FUNCTION_DEFINITION { @Scale(REJECTABLE,ALLOW_NULLS,"@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>__MapConversion.Scale<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler)","@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>__MapConversion.Scale<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler)","@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>__MapConversion.Scale<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler)",RASTER_EXTENTS) }    OUTPUT { COMPLETE FEATURE_TYPE $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_Scaled }    OUTPUT { REJECTED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_<REJECTED>"        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_Rejector }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    INPUT FEATURE_TYPE ___TOREJECTOR___    TEST @Value(fme_rejection_code) != ""    OUTPUT { PASSED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_<REJECTED>"       @RemoveAttributes(___fme_rejection_code___)        }    OUTPUT { FAILED FEATURE_TYPE $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_Scaled       @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_PointCloudScaler }    INPUT { FEATURE_TYPE $(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_Scaled }    TEST &fme_type == "fme_point_cloud"    TEST { "" != "" }    BOOLEAN_OPERATOR AND    OUTPUT { PASSED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_SCALED"       @TransformPointCloud(SCALE,)        }    OUTPUT { FAILED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Scaler_SCALED"        }
