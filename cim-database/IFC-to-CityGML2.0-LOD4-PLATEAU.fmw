FACTORY_DEF {*} JSONQueryFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_JSONFlattener }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Input"    MODE FLATTEN    PREF_STRING { "__" }    JSON_DOCUMENT { "@EvaluateExpression(FDIV,STRING_ENCODED,$($(PLATEAU4.Reprojector_WORKSPACE_NAME)_REPROJECTION_PARAMS),$(PLATEAU4.Reprojector_WORKSPACE_NAME)_JSONFlattener)" }    READ_FROM_FILE { NO }    FILEPATH_OR_URL { "<Unused>" }    EXPLODE_QUERY "json"    RECURSIVE_FLATTEN { YES }    ERROR_LIST_ATTR { "_json_error" }    OUTPUT { EXPLODED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_JSONFlattener_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_JSONFlattener_<REJECTED>"        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_JSONFlattener_<Rejected>" INPUT FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_JSONFlattener_<REJECTED>"  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, PLATEAU4.Reprojector_JSONFlattener<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
