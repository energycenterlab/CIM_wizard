FACTORY_DEF {*} GeometryFilterFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_GeometryFilter }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeExposer_OUTPUT"    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    FILTER_TYPES { Null }    INSTANCES { INSTANTIATE }    BREAK_AGG { Yes }    OUTPUT { <UNFILTERED> FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_GeometryFilter_<UNFILTERED>"  }    OUTPUT { Null FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_GeometryFilter_Null"  }
