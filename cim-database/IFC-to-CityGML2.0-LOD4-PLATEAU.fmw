INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(PLATEAU4.Reprojector_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(PLATEAU4.Reprojector_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Input1792153122 Input Splitter"   INPUT FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Input"
