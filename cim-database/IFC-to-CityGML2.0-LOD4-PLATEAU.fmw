# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "_json_error<opencurly><closecurly> _json_error<opencurly><closecurly>.column _json_error<opencurly><closecurly>.line _json_error<opencurly><closecurly>.message _json_error<opencurly><closecurly>.severity"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_REPROJECTED"    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_CoordinateSystemSetter_OUTPUT"    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_CoordinateSystemRemover_OUTPUT"    OUTPUT { FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,__MapConversion.Eastings,__MapConversion.Northings,__MapConversion.OrthogonalHeight,__MapConversion.Scale,__MapConversion.XAxisAbscissa,__MapConversion.XAxisOrdinate,__ProjectedCRS.Description,__ProjectedCRS.GeodeticDatum,__ProjectedCRS.MapProjection,__ProjectedCRS.MapZone,__ProjectedCRS.Name,__ProjectedCRS.VerticalDatum,fme_rejection_code)        $($(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Ourput1792153122 Output Collector"   INPUT FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Ourput"
