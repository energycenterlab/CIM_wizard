FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(XMLDeepCleaner_WORKSPACE_NAME)_Tester }    INPUT  FEATURE_TYPE "$(XMLDeepCleaner_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    TEST { __attribute NOT_ATTRIBUTE_HAS_A_VALUE "" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(XMLDeepCleaner_WORKSPACE_NAME)_Tester_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(XMLDeepCleaner_WORKSPACE_NAME)_Tester_FAILED"         }
