# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_IFC_1)   INPUT FEATURE_TYPE *    ROUTE IFC IFC_1::IfcBuilding multi_reader_keyword,$(DATASET_KEYWORD_IFC_1) TO FME_GENERIC ::IfcBuilding ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
IFC_1_MERGE_DEF IFC_1::IfcBuilding GLOB *
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "IfcBuilding_IFC_1 Splitter"    INPUT FEATURE_TYPE IfcBuilding    OUTPUT FEATURE_TYPE IfcBuilding_IFC_1_0_AXqZhbO7/M8=    OUTPUT FEATURE_TYPE IfcBuilding_IFC_1_1_wpDPtXwofdE=
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
Lookup FeatureTypeFilter_Main_Lut   IfcSite ok   IfcProject ok   IfcBuilding ok   <lt>Unfiltered<gt> ok   IfcBuildingStorey ok   IfcTypeObject ok   PropertySetDefinition ok   QuantitySetDefinitiotion ok   <lt>Blank<gt> ok   "" notok   ENCODED
FACTORY_DEF {*} TestFactory    FACTORY_NAME { FeatureTypeFilter_Main }    INPUT  FEATURE_TYPE IfcBuilding_IFC_1_0_AXqZhbO7/M8=    TEST { @Lookup(FeatureTypeFilter_Main_Lut,fme_feature_type,ENCODED_ATTR) == "ok" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE * @FeatureType(FeatureTypeFilter_Main_&fme_feature_type) }    OUTPUT { FAILED FEATURE_TYPE FeatureTypeFilter_Main_<UNFILTERED> }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { FeatureTypeFilter_Main_BlankFilter }    INPUT { FEATURE_TYPE FeatureTypeFilter_Main_<UNFILTERED> }    TEST @Value(fme_feature_type) == ""    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE FeatureTypeFilter_Main_<BLANK> }    OUTPUT { FAILED FEATURE_TYPE FeatureTypeFilter_Main_<UNFILTERED> }
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureTypeFilter_Main IfcSite Transformer Output Nuker"   INPUT FEATURE_TYPE FeatureTypeFilter_Main_IfcSite
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureTypeFilter_Main IfcTypeObject Transformer Output Nuker"   INPUT FEATURE_TYPE FeatureTypeFilter_Main_IfcTypeObject
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureTypeFilter_Main PropertySetDefinition Transformer Output Nuker"   INPUT FEATURE_TYPE FeatureTypeFilter_Main_PropertySetDefinition
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureTypeFilter_Main QuantitySetDefinitiotion Transformer Output Nuker"   INPUT FEATURE_TYPE FeatureTypeFilter_Main_QuantitySetDefinitiotion
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureTypeFilter_Main <BLANK> Transformer Output Nuker"   INPUT FEATURE_TYPE FeatureTypeFilter_Main_<BLANK>
# -------------------------------------------------------------------------
Tcl2 proc ParameterFetcher_doFetch {} {    foreach {name val} {"ProjectedCRS.Name {$(CRS_NAME$encode)} MapConversion.Eastings {$(EASTINGS$encode)} MapConversion.Northings {$(NORTHINGS$encode)} MapConversion.OrthogonalHeight {$(ORTHOBONAL_HEIGHT$encode)} MapConversion.XAxisAbscissa {$(XAXIS_ABSCISSA$encode)} MapConversion.XAxisOrdinate {$(XAXIS_ORDINATE$encode)} MapConversion.Scale {$(SCALE$encode)} _reprojection_mode {$(REPROJECTION_MODE$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { ParameterFetcher }    INPUT  FEATURE_TYPE FeatureTypeFilter_Main_IfcProject    OUTPUT { FEATURE_TYPE ParameterFetcher_OUTPUT         @Tcl2(ParameterFetcher_doFetch)          }
