# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {NullAttributeMapper_ba90d04d_b572_4ae9_a8d1_6815e40506cd2} ]
Tcl2 proc $(FME_UUID_SAFE)_null_replacer { otherValue newValue regExp } {    set attrs [split {LongName Name Description ObjectType Tag} { }];    set decode true;    if { {SELECTED} == {ALL} } {       set attrs [FME_AttributeNames];       set decode false; 	 };    set decodedVal [FME_DecodeText $otherValue];    set decodedRegExp [FME_DecodeText $regExp];    foreach attr $attrs {      set act {NOOP};      if {$decode} {        set attr [FME_DecodeText $attr];      };      if {[FME_AttributeExists $attr]} {          set attrVal [FME_GetAttribute $attr];          if {[FME_IsAttributeNull $attr] } {             if {[string first {SETNULL} {MISSINGATTR EMPTY}] != -1} {                 set act {EMPTY};             };          }          elseif { [string first {EMPTY} {MISSINGATTR EMPTY}] != -1 && $attrVal == {}} {             set act {EMPTY};          }          elseif { $otherValue != {} && [string equal $attrVal $decodedVal]} {             set act {EMPTY};          }          elseif { $decodedRegExp != {} }          {             set results [FME_GetRegex $decodedRegExp $attrVal];             if {[llength [lindex $results 0]] > 0}             {                set act {EMPTY};             }          };      }      elseif {[string first {MISSINGATTR} {MISSINGATTR EMPTY}] != -1} {             set act {EMPTY};      };      if {$act == {DELETEATTR} } {         FME_UnsetAttributes $attr;      } elseif { $act == {SETVALUE} } {         FME_SetAttribute $attr [FME_DecodeText $newValue];      } elseif { $act == {SETNULL} } {         FME_SetAttributeNull $attr;      } elseif { $act == {EMPTY} }      {         FME_SetAttribute $attr {};      };   }; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { NullAttributeMapper }    INPUT  FEATURE_TYPE BrepSolidReplacer_Output    INPUT  FEATURE_TYPE GeometryFilter_Face    OUTPUT { FEATURE_TYPE NullAttributeMapper_OUTPUT         @Tcl2("$(FME_UUID_SAFE)_null_replacer {} {<Unused>} {}")       }
