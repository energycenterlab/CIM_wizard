Tcl2 proc $(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_CoordSysRemover {} {    global FME_CoordSys;    set FME_CoordSys {}; }
MACRO $(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_REMOVE_CS
# Only remove the feature coordinate system if a source coordinate system was manually chosen.
INCLUDE [    if { {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>__ProjectedCRS.Name<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector)} != {} } {       puts {MACRO $(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_REMOVE_CS @Tcl2($(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_CoordSysRemover)};    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector }    INPUT  FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_Tester_2_PASSED"    OUTPUT { FEATURE_TYPE "$(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_REPROJECTED"         $($(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector_REMOVE_CS)         @Reproject(PROJREPROJECT,"","","@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>__ProjectedCRS.Name<closeparen>,$(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector)","@EvaluateExpression(FDIV,STRING_ENCODED,$($(PLATEAU4.Reprojector_WORKSPACE_NAME)_DEST_COORDSYS$encode),$(PLATEAU4.Reprojector_WORKSPACE_NAME)_PROJReprojector)","<Unused>","","<Unused>",--,NearestNeighbor,PreserveCells,RASTER_TOLERANCE,"0.0")          }
