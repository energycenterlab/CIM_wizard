# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO GeometryReplacer_4_SetTempAttr
MACRO GeometryReplacer_4_Function
MACRO GeometryReplacer_4_RemoveTempAttr
MACRO GeometryReplacer_4_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geometry<closeparen>,GeometryReplacer_4)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO GeometryReplacer_4_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO GeometryReplacer_4_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO GeometryReplacer_4_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{fmebinary} == {fmebinary} } {               puts "MACRO GeometryReplacer_4_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmehex} } {               puts "MACRO GeometryReplacer_4_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmexml} } {               puts "MACRO GeometryReplacer_4_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmexmlencoded} } {               puts "MACRO GeometryReplacer_4_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{fmebinary} == {polyline} } {               puts "MACRO GeometryReplacer_4_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {wkt} } {               puts "MACRO GeometryReplacer_4_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {wkb} ||                      {fmebinary} == {wkbhex} } {               puts "MACRO GeometryReplacer_4_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GEOJSON} ||                     {fmebinary} == {ESRIJSON} } {               puts "MACRO GeometryReplacer_4_Function @JSONGeometry(FROM_ATTRIBUTE,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GEORSS} } {               puts "MACRO GeometryReplacer_4_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {KML} } {               puts "MACRO GeometryReplacer_4_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GML} } {               puts "MACRO GeometryReplacer_4_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {geohash} } {               puts "MACRO GeometryReplacer_4_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {ogeosms} ||                     {fmebinary} == {geosms}  ||                     {fmebinary} == {geo} } {               puts "MACRO GeometryReplacer_4_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {mgrs}} {               puts "MACRO GeometryReplacer_4_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geometry<closeparen>,GeometryReplacer_4)\")"           } elseif {{fmebinary} == {mssql} } {               puts "MACRO GeometryReplacer_4_Function @SerializeGeometry(from_attribute,fmebinary,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {iso6709} } {               puts "MACRO GeometryReplacer_4_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {qlikmaps} } {               puts "MACRO GeometryReplacer_4_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { GeometryReplacer_4_Rejector }    COMMAND_PARM_EVALUATION SINGLE_PASS    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    INPUT  FEATURE_TYPE SpatialFilter_2_FAILED    $(GeometryReplacer_4_SetTempAttr)    FUNCTION_DEFINITION { $(GeometryReplacer_4_Function) }    OUTPUT { COMPLETE FEATURE_TYPE GeometryReplacer_4_OUTPUT        $(GeometryReplacer_4_RemoveTempAttr) $(GeometryReplacer_4_RemoveSourceAttr) }    OUTPUT { REJECTED FEATURE_TYPE GeometryReplacer_4_<REJECTED>        $(GeometryReplacer_4_RemoveTempAttr) }
