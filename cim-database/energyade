CREATE FUNCTION citydb_pkg.get_child_objectclass_ids(class_id integer, skip_abstract integer DEFAULT 0) RETURNS SETOF integer
    LANGUAGE plpgsql STABLE STRICT
    AS $$
DECLARE
  condition TEXT := '';
BEGIN
  IF skip_abstract <> 0 THEN
    condition = 'AND h.is_abstract <> 1';
  END IF;
  
  RETURN QUERY EXECUTE format('
    WITH RECURSIVE class_hierarchy AS (
      SELECT o.id, o.is_abstract
      FROM objectclass o
      WHERE o.id = %L
      UNION ALL
      SELECT p.id, p.is_abstract
      FROM objectclass p
      INNER JOIN class_hierarchy h ON h.id = p.superclass_id
    )
    SELECT h.id
    FROM class_hierarchy h
    WHERE h.id <> %L ' || condition,
    class_id, class_id);
END;
$$;


