    citydb_pkg.delete_property_row(array_agg(p.id))
  FROM
    property p,
    unnest($1) AS a(a_id)
  WHERE
    p.feature_id = a.a_id;

  SELECT
    array_agg(p.val_feature_id),
    array_agg(p.id)
  INTO
    candidate_ids,
    feature_property_ids
  FROM
    property p,
    unnest($1) AS a(a_id)
  WHERE
    p.val_feature_id = a.a_id;

  WITH delete_objects AS (
    DELETE FROM
      feature f
    USING
      unnest($1) AS a(a_id)
    WHERE
      f.id = a.a_id
    RETURNING
      id
  )
  SELECT
    array_agg(id)
  INTO
    deleted_ids
  FROM
    delete_objects;

  PERFORM citydb_pkg.delete_property(feature_property_ids);

  RETURN QUERY
    SELECT unnest(deleted_ids)
    UNION
    SELECT unnest(candidate_ids);
