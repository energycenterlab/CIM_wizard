SELECT citydb.del_ng3_qualified_attribute(id) FROM citydb.ng3_qualified_attribute;

-- Time Series module
SELECT citydb.del_ng3_time_series(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('RegularTimeSeries', 'RegularTimeSeriesFile', 'TypicalValuesTimeSeries', 'TypicalValuesTimeSeriesFile', 'SensorConnection');

-- Schedules module
SELECT citydb.del_ng3_schedule(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('AtomicSchedule', 'DualValueSchedule', 'CompositeSchedule');
SELECT citydb.del_ng3_schedule_component(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id AND o.classname='ScheduleComponent');
SELECT citydb.del_ng3_library(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id AND o.classname='ScheduleLibrary');

-- Layered Construction module
SELECT citydb.del_ng3_material(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('Gas', 'SolidMaterial');
SELECT citydb.del_ng3_layer(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('Layer');
SELECT citydb.del_ng3_layered_construction(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('LayeredConstruction', 'ReverseLayeredConstruction');
SELECT citydb.del_ng3_library(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('MaterialLibrary', 'LayeredConstructionLibrary');

-- Resource module
SELECT citydb.del_ng3_resource(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id)
	WHERE o.classname IN ('Energy', 'Water', 'Waste', 'Food', 'UrbanSpace', 'ConstructionMaterial', 'OtherResource');

-- Weather Station module
SELECT citydb.del_cityobject(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id AND o.classname='WeatherStation');

