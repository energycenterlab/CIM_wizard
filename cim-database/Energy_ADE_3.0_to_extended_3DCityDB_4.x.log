SELECT citydb.del_ng3_refurbishment_measure(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id AND o.classname='RefurbishmentMeasure');

-- Urban Function Area module
SELECT citydb.del_ng3_urban_function_area(co.id) FROM citydb.cityobject AS co JOIN citydb.objectclass AS o ON (co.objectclass_id = o.id AND o.classname='UrbanFunctionArea');

-- Devices module
