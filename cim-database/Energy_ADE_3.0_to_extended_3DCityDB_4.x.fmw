INCLUDE [if { {ATTRIBUTES} == {ATTRIBUTES} } {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO ATTRIBUTES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} } {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} } {                puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          else {}; ]
FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9 }    GROUP_BY { <Unused> }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_CityGMLClassRenamer_AttributeRemover_3_Output"    INPUT REFERENCEE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    CONNECT_Z_MODE { <Unused> }    REFERENCE_INFO { $($(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>objectclass_name<closeparen>,$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "REQUESTOR_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    SUPPLIER_PREFIX { "<Unused>" }    LIST_NAME { "<Unused>" }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MERGE_COUNT_ATTR { "<Unused>" }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_MERGED"         }    OUTPUT { INCOMPLETE FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_UNMERGED_REQUESTOR"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} SortFactory    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_Sorter }    INPUT  FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_FeatureMerger_9_MERGED"    SORT_ALPHA_AS_UTF8 { YES }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    SORT_BY { gmlid NATURAL ASCENDING }    OUTPUT { SORTED FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_Sorter_SORTED"          }
