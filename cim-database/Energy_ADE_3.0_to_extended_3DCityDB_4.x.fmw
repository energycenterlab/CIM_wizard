FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(XLinkUpdater_WORKSPACE_NAME)_AttributeCreator }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_0<space>1"    INPUT  FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_0<space>2"    INPUT  FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_1<space>0"    INPUT  FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_1<space>2"    INPUT  FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_2<space>0"    INPUT  FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_TestFilter_2<space>1"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "is_xlink" "SET_TO" "<at>Value<openparen>is_xlink_new<closeparen>" "number<openparen>1000<comma>500<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(XLinkUpdater_WORKSPACE_NAME)_AttributeCreator_OUTPUT"        }
