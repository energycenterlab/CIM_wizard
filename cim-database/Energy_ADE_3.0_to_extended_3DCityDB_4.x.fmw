# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "_list<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC }    } else {        puts "MACRO $(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3 }    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_Junction_Output"    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_Junction_2_Output"    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_Junction_3_Output"    INPUT  FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeFilter_<lt>UNFILTERED<gt>"    OUTPUT { FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"        @RemoveAttributes(fme_encoded,objectclass_name_prefix,fme_feature_type,objectclass_name_prefix2)        $($(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_Output1791566344 Output Collector"   INPUT FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"   OUTPUT FEATURE_TYPE "$(CityGMLClassRenamer_WORKSPACE_NAME)_AttributeRemover_3_Output"
