FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator_54 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE Tester_2_PASSED    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "sql_statement" "SET_TO" "SELECT<space>count<openparen>*<closeparen><space>AS<space>test2<space>FROM<space>$(citydb_schema$encode).ade<space>WHERE<space>name<space>=<space><apos>Energy<space>ADE<apos><space>AND<space>db_prefix<space>=<space><apos>ng3<apos><space>AND<space>version<space>=<space><apos>$(Energy_ADE_3.0_version$encode)<apos><semicolon>" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_54_OUTPUT        }
