ecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_library_member<opencurly><closecurly>.xlink_href" "nrg3_library_member<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_resource<opencurly><closecurly>.xlink_href" "nrg3_resource<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_utility_network_connection<opencurly><closecurly>.xlink_href" "nrg3_utility_network_connection<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_weather_data<opencurly><closecurly>.xlink_href" "nrg3_weather_data<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }    OUTPUT { OUTPUT FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeManager_OUTPUT"        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "citygml_appearance<opencurly><closecurly> nrg3_device<opencurly><closecurly> nrg3_library_member<opencurly><closecurly> nrg3_resource<opencurly><closecurly> nrg3_utility_network_connection<opencurly><closecurly> nrg3_weather_data<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeManager_OUTPUT"    OUTPUT { FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,)        $($(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
