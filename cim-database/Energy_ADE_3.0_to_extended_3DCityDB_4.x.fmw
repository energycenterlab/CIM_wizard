FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeManager }    INPUT  FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_ADE_CityObject"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 4    DEF_VAL_COLUMN 2    NUM_OF_COLUMNS 5    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "gml_parent_id" "gml_parent_id" "" "buffer" "NO_OP" }      ATTR_ACTION { "gml_id" "gmlid" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "citygml_target_uri" "citygml_target_uri" "" "buffer" "REMOVE" }      ATTR_ACTION { "citygml_feature_role" "citygml_feature_role" "" "buffer" "NO_OP" }      ATTR_ACTION { "citygml_feature_role_attr_name" "citygml_feature_role_attr_name" "" "buffer" "REMOVE" }      ATTR_ACTION { "citygml_feature_role_attr_val" "citygml_feature_role_attr_val" "" "buffer" "REMOVE" }      ATTR_ACTION { "gml_description" "description" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "gml_name" "name" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "citygml_creationDate" "creation_date" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "citygml_terminationDate" "termination_date" "" "buffer" "RENAME_SET_VALUE" }      ATTR_ACTION { "citygml_relative_to_terrain" "relative_to_terrain" "" "varchar<openparen>33<closeparen>" "RENAME_SET_VALUE" }      ATTR_ACTION { "citygml_relative_to_water" "relative_to_water" "" "varchar<openparen>38<closeparen>" "RENAME_SET_VALUE" }      ATTR_ACTION { "objectclass_name" "objectclass_name" "" "varchar<openparen>256<closeparen>" "NO_OP" }      ATTR_ACTION { "objectclass_id" "objectclass_id" "" "int32" "NO_OP" }      ATTR_ACTION { "citygml_appearance<opencurly><closecurly>.xlink_href" "citygml_appearance<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_device<opencurly><closecurly>.xlink_href" "nrg3_device<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_library_member<opencurly><closecurly>.xlink_href" "nrg3_library_member<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_resource<opencurly><closecurly>.xlink_href" "nrg3_resource<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_utility_network_connection<opencurly><closecurly>.xlink_href" "nrg3_utility_network_connection<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }      ATTR_ACTION { "nrg3_weather_data<opencurly><closecurly>.xlink_href" "nrg3_weather_data<opencurly><closecurly>.xlink_href" "" "buffer" "NO_OP" }    OUTPUT { OUTPUT FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeManager_OUTPUT"        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "citygml_appearance<opencurly><closecurly> nrg3_device<opencurly><closecurly> nrg3_library_member<opencurly><closecurly> nrg3_resource<opencurly><closecurly> nrg3_utility_network_connection<opencurly><closecurly> nrg3_weather_data<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeManager_OUTPUT"    OUTPUT { FEATURE_TYPE "$(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,)        $($(ADE_CityObject_editor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
