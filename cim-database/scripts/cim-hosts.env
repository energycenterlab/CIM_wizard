# Hosts and DB names for laptop-side snapshot scripts.
# Sourced by snapshot-c3-to-c4.sh and snapshot-c4-to-c3.sh.
# Do not put passwords here — SSH will prompt (or use ssh-agent keys).

C3_SSH="${C3_SSH:-eclabuser@130.192.238.11}"
C4_SSH="${C4_SSH:-eclabuser@130.192.238.12}"

PGUSER="${PGUSER:-cim_wizard_user}"
PGDB="${PGDB:-cim_wizard_integrated}"
CONTAINER="${CONTAINER:-cim-integrateddb}"

# Bind-mounted backups dir inside each DB container (see docker-compose)
REMOTE_BACKUPS="${REMOTE_BACKUPS:-/backups}"
C3_HOST_BACKUPS="${C3_HOST_BACKUPS:-~/cim/cim-database/backups}"
C4_HOST_BACKUPS="${C4_HOST_BACKUPS:-~/cim/cim-database/backups}"
C4_ARCHIVE="${C4_ARCHIVE:-~/cim-db-backups/cloud3}"

# Staging dir on the laptop (C3 → here → C4). Avoids nested SSH.
LOCAL_STAGE="${LOCAL_STAGE:-${TMPDIR:-/tmp}/cim-db-snapshots}"

# Reuse one SSH TCP connection per host so you type each password once.
SSH_OPTS=(
  -o ControlMaster=auto
  -o ControlPath="${LOCAL_STAGE}/ssh-%C"
  -o ControlPersist=10m
  -o StrictHostKeyChecking=accept-new
)
