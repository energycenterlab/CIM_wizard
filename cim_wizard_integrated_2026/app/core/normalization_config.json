{
  "_meta": {
    "version": "1.0.0",
    "description": "Field normalization configuration for CIM Wizard Integrated API. This file is the single source of truth for field naming across all clients. Each entity defines canonical field names (matching DB columns) and known aliases from various sources (frontend, Postman, GIS tools, Italian data sources, etc.).",
    "usage": "Clients can fetch this config via GET /api/v1/vector/schema to auto-discover canonical field names and build their own mappings."
  },

  "entities": {

    "project_scenario": {
      "description": "Project and scenario metadata. Maps to cim_vector.cim_wizard_project_scenario",
      "table": "cim_vector.cim_wizard_project_scenario",
      "fields": {
        "project_id": {
          "type": "string",
          "required": true,
          "description": "Unique project identifier (UUID)",
          "aliases": ["projectId", "project_ID", "proj_id", "ProjectId", "ProjectID"]
        },
        "scenario_id": {
          "type": "string",
          "required": true,
          "description": "Unique scenario identifier (UUID)",
          "aliases": ["scenarioId", "scenario_ID", "ScenarioId", "ScenarioID"]
        },
        "project_name": {
          "type": "string",
          "required": false,
          "description": "Human-readable project name",
          "aliases": ["projectName", "proj_name", "ProjectName", "name"]
        },
        "scenario_name": {
          "type": "string",
          "required": false,
          "description": "Human-readable scenario name",
          "aliases": ["scenarioName", "ScenarioName"]
        },
        "project_boundary": {
          "type": "geometry",
          "geometry_type": "Polygon",
          "srid": 4326,
          "required": false,
          "description": "Project boundary as GeoJSON Polygon",
          "aliases": ["projectBoundary", "boundary", "project_geom", "project_geometry"]
        },
        "project_center": {
          "type": "geometry",
          "geometry_type": "Point",
          "srid": 4326,
          "required": false,
          "description": "Project center point as GeoJSON Point (auto-calculated from boundary centroid)",
          "aliases": ["projectCenter", "center", "centroid"]
        },
        "project_zoom": {
          "type": "integer",
          "required": false,
          "default": 15,
          "description": "Default map zoom level",
          "aliases": ["projectZoom", "zoom", "map_zoom"]
        },
        "project_crs": {
          "type": "integer",
          "required": false,
          "default": 4326,
          "description": "Coordinate reference system EPSG code",
          "aliases": ["projectCrs", "crs", "epsg", "srid", "CRS", "EPSG"]
        },
        "census_boundary": {
          "type": "geometry",
          "geometry_type": "MultiPolygon",
          "srid": 4326,
          "required": false,
          "description": "Census sections boundary covering the project area",
          "aliases": ["censusBoundary", "census_geom"]
        },
        "created_at": {
          "type": "datetime",
          "required": false,
          "description": "Record creation timestamp (auto-generated)",
          "aliases": ["createdAt", "created", "creation_date"]
        },
        "updated_at": {
          "type": "datetime",
          "required": false,
          "description": "Record last update timestamp (auto-generated)",
          "aliases": ["updatedAt", "updated", "modification_date", "last_modified"]
        }
      }
    },

    "building": {
      "description": "Building geometry records. Maps to cim_vector.cim_wizard_building",
      "table": "cim_vector.cim_wizard_building",
      "fields": {
        "building_id": {
          "type": "string",
          "required": true,
          "description": "Unique building identifier (UUID)",
          "aliases": ["buildingId", "building_ID", "BuildingId", "BuildingID", "ID", "id", "Id", "fid", "FID", "gml_id", "osm_id"]
        },
        "lod": {
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "Level of Detail (0=footprint, 1=extruded, 2=detailed)",
          "aliases": ["LOD", "level_of_detail", "levelOfDetail"]
        },
        "building_geometry": {
          "type": "geometry",
          "geometry_type": "Geometry",
          "srid": 4326,
          "required": true,
          "description": "Building geometry (Polygon for footprint, MultiPolygon for complex)",
          "aliases": ["geometry", "geom", "building_geom", "the_geom", "shape"]
        },
        "building_geometry_source": {
          "type": "string",
          "required": true,
          "description": "Source of the geometry data (e.g., 'osm', 'cadastre', 'integrated_database')",
          "aliases": ["geometrySource", "geom_source", "source", "data_source"]
        },
        "census_id": {
          "type": "integer",
          "required": false,
          "description": "Census section ID (links to censusgeo.SEZ2011)",
          "aliases": ["censusId", "census_ID", "SEZ2011", "sez2011", "section_id", "nsez"]
        },
        "building_surfaces_lod12": {
          "type": "json",
          "required": false,
          "description": "LoD 1.2 surface geometry data (walls, roof, ground)",
          "aliases": ["surfaces_lod12", "lod12_surfaces", "surfacesLod12"]
        },
        "created_at": {
          "type": "datetime",
          "required": false,
          "description": "Record creation timestamp",
          "aliases": ["createdAt", "created", "creation_date"]
        },
        "updated_at": {
          "type": "datetime",
          "required": false,
          "description": "Record last update timestamp",
          "aliases": ["updatedAt", "updated", "modification_date"]
        }
      }
    },

    "building_properties": {
