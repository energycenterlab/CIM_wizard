        },
        "volume": {
          "type": "float",
          "required": false,
          "description": "Building volume in cubic meters",
          "value_range": [0, 1000000],
          "unit": "m3",
          "aliases": ["Volume", "building_volume", "net_leased_volume", "Net Leased Volume"]
        },
        "number_of_floors": {
          "type": "float",
          "required": false,
          "description": "Number of floors / stories",
          "value_range": [0, 200],
          "aliases": ["numberOfFloors", "Number of Floors", "num_piani", "n_floors", "floors", "total_floors", "Total Floors", "stories"]
        },
        "type": {
          "type": "string",
          "required": false,
          "description": "Building usage type (e.g., 'residential', 'commercial', 'industrial')",
          "aliases": ["Type", "building_type", "Building Type", "usage_type", "Usage Type", "usage_category", "Usage Category", "categ_uso", "usage", "tab_type", "land_use"]
        },
        "const_period_census": {
          "type": "string",
          "required": false,
          "description": "Construction period from census data (e.g., '1961-70')",
          "aliases": ["constPeriodCensus", "construction_period", "Construction Period", "epoca_cost", "period"]
        },
        "const_year": {
          "type": "integer",
          "required": false,
          "description": "Construction year",
          "value_range": [1800, 2030],
          "aliases": ["constYear", "construction_year", "year", "Year", "built_year", "anno_costruzione"]
        },
        "const_tabula": {
          "type": "string",
          "required": false,
          "description": "TABULA building typology classification",
          "aliases": ["constTabula", "tabula", "tabula_type", "TABULA"]
        },
        "n_people": {
          "type": "integer",
          "required": false,
          "description": "Number of people (residents) in the building",
          "value_range": [0, 10000],
          "aliases": ["nPeople", "n_People", "Number of People", "number_of_people", "population", "residents", "abitanti"]
        },
        "n_family": {
          "type": "integer",
          "required": false,
          "description": "Number of families / households in the building",
          "value_range": [0, 1000],
          "aliases": ["nFamily", "n_families", "Number of Families", "number_of_families", "families", "households", "nuclei_familiari"]
        },
        "envelope_efficiency": {
          "type": "string",
          "required": false,
          "description": "Envelope efficiency classification: low, medium, or high",
          "aliases": ["envelopeEfficiency", "EnvelopeEfficiency", "envelope_efficiency_class"]
        },
        "filter_res": {
          "type": "boolean",
          "required": false,
          "description": "Whether the building is classified as residential (true) or non-residential (false)",
          "aliases": ["filterRes", "filter_residential", "is_residential", "residential"]
        },
        "created_at": {
          "type": "datetime",
          "required": false,
          "description": "Record creation timestamp",
          "aliases": ["createdAt", "created"]
        },
        "updated_at": {
          "type": "datetime",
          "required": false,
          "description": "Record last update timestamp",
          "aliases": ["updatedAt", "updated"]
        }
