          "aliases": ["buildingId", "building_ID", "BuildingId", "ID", "id", "Id", "fid", "FID"]
        },
        "scenario_id": {
          "type": "string",
          "required": true,
          "description": "Scenario identifier",
          "aliases": ["scenarioId", "scenario_ID", "ScenarioId"]
        },
        "project_id": {
          "type": "string",
          "required": true,
          "description": "Project identifier",
          "aliases": ["projectId", "project_ID", "ProjectId"]
        },
        "lod": {
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "Level of Detail",
          "aliases": ["LOD", "level_of_detail"]
        },
        "height": {
          "type": "float",
          "required": false,
          "description": "Building height in meters",
