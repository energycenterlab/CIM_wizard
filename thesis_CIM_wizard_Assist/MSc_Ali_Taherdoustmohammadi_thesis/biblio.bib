%human performance is better than models in text to sql at nov2025
@misc{bird-bench,
  title = {{BIRD-SQL}: A Big Bench for Large-Scale Database Grounded Text-to-SQL Evaluation},
  author = {BIRD Team},
  year = {2025},
  howpublished = {\url{https://bird-bench.github.io/}},
  note = {Accessed: November 2025},
  abstract = {BIRD (Big Bench for Large-Scale Database Grounded Text-to-SQL Evaluation) represents a pioneering, cross-domain dataset that examines the impact of extensive database contents on text-to-SQL parsing. BIRD contains over 12,751 unique question-SQL pairs, 95 big databases with a total size of 33.4 GB, and covers more than 37 professional domains, such as blockchain, hockey, healthcare and education. As of November 2025, human database experts achieve 92.96\% execution accuracy on the benchmark, while the best automated systems achieve approximately 76.13\% execution accuracy, demonstrating the persistent challenge of Text-to-SQL generation.}
}


