# Copy this file to secrets.toml and fill in your values.
# secrets.toml is git-ignored — never commit it.

# PostGIS connection string.
DATABASE_URL = "postgresql://datalake:datalake@localhost:35432/datalake"

# FastAPI warehouse backend (used by ingest_api.py)
API_BASE_URL = "http://localhost:8008"

# MinIO object storage (raw / cold file assets).
# Prefer setting MINIO_URI in ingest.sh — env overrides these values.
# Bucket must already exist (e.g. create "datawh" in the MinIO console).
[minio]
endpoint   = "localhost:9000"
access_key = "minioadmin"
secret_key = "minioadmin"
bucket     = "datawh"
secure     = false

# FTP server used for raw file storage (legacy — prefer MinIO).
[ftp]
host     = "localhost"
# user     = "your_ftp_username"
# password = "your_ftp_password"
root     = "/datalake/root/"
